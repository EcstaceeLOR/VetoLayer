# Public browser-safe application/auth configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# SERV Reasoning (server-only)
SERV_API_KEY=
SERV_MODEL=
SERV_BASE_URL=https://inference-api.openserv.ai/v1
SERV_TIMEOUT_MS=20000

# GitHub App (server-only, one-time deployment registration)
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_WEBHOOK_SECRET=

# Durable Supabase persistence (server-only; required for production workspace entities,
# GitHub App installations, developer credentials/webhooks/usage, notification delivery,
# settings/retention policy, and product history)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Stable, high-entropy server secret used to encrypt recoverable webhook signing credentials.
VETOLAYER_CREDENTIAL_ENCRYPTION_KEY=

# Human workflow email notifications (server-only). VetoLayer uses the Resend HTTPS API
# directly, so no provider SDK is required in the application bundle.
RESEND_API_KEY=
VETOLAYER_NOTIFICATION_FROM_EMAIL=

# Durable notification/webhook retry worker authorization. Set a high-entropy value and
# schedule GET or POST /api/internal/notification-deliveries with Authorization: Bearer <secret>.
# CRON_SECRET is also accepted when VETOLAYER_DELIVERY_WORKER_SECRET is not set.
VETOLAYER_DELIVERY_WORKER_SECRET=

# Retention worker authorization. Vercel invokes /api/internal/retention daily. A dedicated
# secret may be used; otherwise CRON_SECRET is accepted. This remains platform infrastructure,
# not a normal workspace setting.
VETOLAYER_RETENTION_WORKER_SECRET=
CRON_SECRET=

# Developer API rate limiting. First-class project/environment keys are created in
# Dashboard -> Developer; new deployments do not need a global API bearer key.
VETOLAYER_API_RATE_LIMIT_PER_MINUTE=60

# Legacy compatibility only while migrating older clients.
VETOLAYER_API_KEY=
VETOLAYER_API_WORKSPACE_ID=service:developer-api
VETOLAYER_API_PROJECT_ID=service:default-project
VETOLAYER_API_ENVIRONMENT_ID=service:production
