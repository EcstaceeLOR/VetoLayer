# --- SERV Reasoning (server-only) ---
# Never expose these with NEXT_PUBLIC_ prefixes.
SERV_API_KEY=
SERV_MODEL=
# Optional. Defaults to the current OpenServ OpenAI-compatible reasoning endpoint.
SERV_BASE_URL=https://inference-api.openserv.ai/v1
# Optional. Defaults to 20000 ms.
SERV_TIMEOUT_MS=20000

# --- Supabase Auth (browser-safe publishable config) ---
# Used by @supabase/ssr for cookie-backed authentication.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Public canonical URL used for auth confirmation redirects when Origin is unavailable.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- GitHub Gate (server-only) ---
# Used only by server-side connection tests and the GitHub gate integration.
# Never expose this through NEXT_PUBLIC_* variables or browser responses.
GITHUB_TOKEN=

# --- Durable product persistence (server-only) ---
# Required for production workspaces/projects/environments/members and recommended
# for decisions, reviews, policies, and integration history. Configure both together.
# The service-role key stays server-only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Public demo controls.
VETOLAYER_DEMO_WORKSPACE_ID=demo
VETOLAYER_DEMO_RATE_LIMIT_PER_MINUTE=30
# Optional explicit seeded dashboard mode. In production, omit this for live/empty
# receipt analytics; set to "demo" only when intentionally presenting seeded data.
VETOLAYER_DASHBOARD_MODE=

# Developer API controls.
# When VETOLAYER_API_KEY is set, /api/v1/* requires Authorization: Bearer <key>.
# Until per-project keys land in the Developer Console, bind this server key to one
# explicit workspace/project/environment scope. Clients cannot override this scope.
VETOLAYER_API_KEY=
VETOLAYER_API_WORKSPACE_ID=service:developer-api
VETOLAYER_API_PROJECT_ID=service:default-project
VETOLAYER_API_ENVIRONMENT_ID=service:production
VETOLAYER_API_RATE_LIMIT_PER_MINUTE=60
