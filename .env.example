# --- SERV Reasoning (server-only) ---
# Never expose these with NEXT_PUBLIC_ prefixes.
SERV_API_KEY=
SERV_MODEL=
# Optional. Defaults to the current OpenServ OpenAI-compatible reasoning endpoint.
SERV_BASE_URL=https://inference-api.openserv.ai/v1
# Optional. Defaults to 20000 ms.
SERV_TIMEOUT_MS=20000

# --- Supabase Auth (browser-safe publishable config) ---
# Used by @supabase/ssr for cookie-backed authentication.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Public canonical URL used for auth and GitHub App callbacks.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- GitHub App (server-only, one-time deployment registration) ---
# End users install/connect GitHub from the product UI; they never paste PATs.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# Store the PEM as a multiline secret or with escaped \\n sequences on hosts that require one line.
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_WEBHOOK_SECRET=

# --- Durable product persistence (server-only) ---
# Required for production workspaces/projects/environments/members, GitHub App installations,
# developer credentials/webhooks, onboarding progress, decisions, reviews, policies, and integration history.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Used to encrypt recoverable server-side credentials such as outbound webhook signing secrets.
# Use a long random server-only value and keep it stable across deploys.
VETOLAYER_CREDENTIAL_ENCRYPTION_KEY=

# Public demo controls.
VETOLAYER_DEMO_WORKSPACE_ID=demo
VETOLAYER_DEMO_RATE_LIMIT_PER_MINUTE=30
# Optional explicit seeded dashboard mode. In production, omit this for live/empty
# receipt analytics; set to "demo" only when intentionally presenting seeded data.
VETOLAYER_DASHBOARD_MODE=

# Developer API controls.
# Normal product use creates project/environment-scoped keys in the Developer Console.
# VETOLAYER_API_KEY and the service scope below remain only as a backwards-compatible
# server-managed credential for deployments that have not migrated yet.
VETOLAYER_API_KEY=
VETOLAYER_API_WORKSPACE_ID=service:developer-api
VETOLAYER_API_PROJECT_ID=service:default-project
VETOLAYER_API_ENVIRONMENT_ID=service:production
VETOLAYER_API_RATE_LIMIT_PER_MINUTE=60
